# Backend only. Use a Beijing-region key; never use a VITE_ secret variable.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
USER_TIMEZONE=Asia/Shanghai
DB_PATH=data/assistant.sqlite3
MODEL_TIMEOUT_SECONDS=30
RUN_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=3
MODEL_RETRIES=1
# Independent IQS credential. Never reuse DASHSCOPE_API_KEY automatically.
IQS_API_KEY=
IQS_ENGINE=Generic
IQS_ENHANCED_SUMMARY=false
SEARCH_TIMEOUT_SECONDS=12
MAX_SEARCH_CALLS=4
SEARCH_RETRIES=1
# Independent QWeather project API key and account host (hostname only).
QWEATHER_API_KEY=
QWEATHER_API_HOST=
WEATHER_TIMEOUT_SECONDS=12
MAX_WEATHER_CALLS=4
WEATHER_RETRIES=1
WEATHER_FORECAST_DAYS=7
